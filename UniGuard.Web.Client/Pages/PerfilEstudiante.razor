@page "/perfil-estudiante/{Id:int}"
@using UniGuard.Shared
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveAuto

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/gestion-estudiantes")'>
            <i class="bi bi-arrow-left"></i> Volver a la Lista
        </button>

        @* --- VALIDACIÓN DE SEGURIDAD PARA EL BOTÓN DE EDITAR --- *@
        @if (userRole == "Administrador" && estudiante != null)
        {
            <button class="btn btn-warning fw-bold shadow-sm animate__animated animate__fadeInRight"
                    @onclick='() => Nav.NavigateTo($"/editar-estudiante/{estudiante.Id}")'>
                <i class="bi bi-pencil-square"></i> EDITAR ESTUDIANTE
            </button>
        }
    </div>

    @if (cargando)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Buscando registro en la base de datos...</p>
        </div>
    }
    else if (estudiante == null)
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="bi bi-exclamation-triangle fs-1"></i>
            <h4 class="mt-3">¡Estudiante no encontrado!</h4>
            <p>El registro con ID <b>@Id</b> no existe en la base de datos.</p>
            <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/gestion-estudiantes")'>Ir a la Lista</button>
        </div>
    }
    else
    {
        <div class="row animate__animated animate__fadeIn">
            @* Tarjeta de Perfil *@
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 overflow-hidden">
                    <div class="bg-primary p-4 text-center">
                        <img src="@(string.IsNullOrEmpty(estudiante.FotoBase64) ? "https://via.placeholder.com/180" : estudiante.FotoBase64)"
                             class="rounded-circle border border-4 border-white shadow"
                             style="width: 180px; height: 180px; object-fit: cover;" />
                    </div>
                    <div class="card-body text-center">
                        <h4 class="fw-bold text-uppercase mb-1">@estudiante.Nombres</h4>
                        <h4 class="fw-bold text-uppercase text-muted small mb-3">@estudiante.Apellidos</h4>
                        <div class="badge @(estudiante.EstaActivo ? "bg-success" : "bg-danger") fs-6 mb-3">
                            @(estudiante.EstaActivo ? "CUENTA ACTIVA" : "CUENTA INACTIVA")
                        </div>
                        <ul class="list-group list-group-flush text-start small">
                            <li class="list-group-item"><b>ID Sistema:</b> @estudiante.Id</li>
                            <li class="list-group-item"><b>Documento:</b> @estudiante.Documento</li>
                        </ul>
                    </div>
                </div>
            </div>

            @* Sección de Equipos e Historial *@
            <div class="col-md-8">
                <div class="card shadow border-0 mb-4">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="bi bi-laptop"></i> Equipos Vinculados</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Serial</th><th>Marca</th><th>Ubicación</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var eq in estudiante.Equipos ?? new())
                                {
                                    <tr>
                                        <td>@eq.Serial</td>
                                        <td>@eq.Marca?.Nombre</td>
                                        <td>@(eq.EstadoActualId == 1 ? "Dentro" : "Fuera")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow border-0 mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Historial de Movimientos</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Fecha</th><th>Acción</th><th>Guardia</th></tr>
                            </thead>
                            <tbody>
                                @if (movimientos.Any())
                                {
                                    @foreach (var mov in movimientos)
                                    {
                                        <tr>
                                            <td>@mov.FechaHora.ToString("dd/MM/yy HH:mm")</td>
                                            <td><span class="badge @(mov.TipoMovimiento == "Entrada" ? "bg-success" : "bg-warning")">@mov.TipoMovimiento</span></td>
                                            <td>@(mov.UsuarioSistema?.NombreUsuario ?? "Admin")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="3" class="text-center py-3">Sin movimientos registrados</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Estudiante? estudiante;
    private List<Movimiento> movimientos = new();
    private bool cargando = true;
    private string? userRole;

    // --- CORRECCIÓN: Captura del Rol para Seguridad ---
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Leemos el rol guardado en el navegador para activar el botón de Editar
            userRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;
            var response = await Http.GetAsync($"api/Estudiantes/{Id}");

            if (response.IsSuccessStatusCode)
            {
                estudiante = await response.Content.ReadFromJsonAsync<Estudiante>();
                movimientos = await Http.GetFromJsonAsync<List<Movimiento>>($"api/Movimientos/estudiante/{Id}") ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error de carga: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}