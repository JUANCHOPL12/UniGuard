@page "/"
@using UniGuard.Shared
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="zen-wrapper">
    <div class="login-clean">

        <div class="brand-header">
            <div class="logo-circle">
                <span class="cun-logo-text">CUN</span>
            </div>
            <h1>UniGuard<span>Pro</span></h1>
            <p class="tagline">CORPORACIÓN UNIFICADA NACIONAL</p>
        </div>

        <div class="inputs-container">
            <div class="input-row">
                <i class="bi bi-person-fill"></i>
                <input @bind="usuario" type="text" placeholder="Usuario"
                       @onkeyup="@(async (e) => { if (e.Key == "Enter") await ProcesarLogin(); })" />
            </div>

            <div class="input-row">
                <i class="bi bi-lock-fill"></i>
                <input @bind="password" type="password" placeholder="Contraseña"
                       @onkeyup="@(async (e) => { if (e.Key == "Enter") await ProcesarLogin(); })" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="error-box">
                @mensajeError
            </div>
        }

        <button class="btn-zen" @onclick="ProcesarLogin" disabled="@cargando">
            @if (cargando)
            {
                <span class="loader"></span>
            }
            else
            {

                <span>ENTRAR</span>
            }
        </button>

        <div class="footer-tag">
            SEGURIDAD INTELIGENTE • CUN
        </div>
    </div>
</div>

<style>
    :root {
        --cun-green: #8CC63F;
        --text-dark: #1a1a1a; /* Texto bien oscuro para que se lea */
        --input-bg: #f0f2f5;
    }

    .zen-wrapper {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-clean {
        width: 100%;
        max-width: 360px;
        text-align: center;
    }

    .logo-circle {
        width: 85px;
        height: 85px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border: 3px solid var(--cun-green);
    }

    .cun-logo-text {
        color: var(--cun-green);
        font-weight: 900;
        font-size: 1.5rem;
    }

    .brand-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-dark); /* Texto oscuro */
        margin-bottom: 0;
    }

        .brand-header h1 span {
            color: var(--cun-green);
            font-weight: 300;
        }

    .tagline {
        color: #444; /* Gris oscuro para legibilidad */
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 35px;
    }

    .input-row {
        display: flex;
        align-items: center;
        background: var(--input-bg);
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 12px;
    }

        .input-row i {
            color: var(--cun-green);
            margin-right: 12px;
        }

        .input-row input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            color: var(--text-dark); /* Texto de entrada oscuro */
            font-weight: 500;
        }

    .btn-zen {
        width: 100%;
        background: var(--cun-green);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 10px;
    }

    .error-box {
        background: #ffe3e3;
        color: #b00000;
        padding: 10px;
        border-radius: 8px;
        font-size: 0.8rem;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .footer-tag {
        margin-top: 40px;
        font-size: 0.6rem;
        color: #888;
        letter-spacing: 1px;
    }

    .loader {
        border: 2px solid rgba(255,255,255,0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private string usuario = "";
    private string password = "";
    private string mensajeError = "";
    private bool cargando = false;

    private async Task ProcesarLogin()
    {
        if (string.IsNullOrWhiteSpace(usuario) || string.IsNullOrWhiteSpace(password))
        {
            mensajeError = "Completa todos los campos.";
            return;
        }

        try
        {
            cargando = true;
            mensajeError = "";

            var loginData = new { Usuario = usuario, Password = password };
            var response = await Http.PostAsJsonAsync("api/Usuarios/login", loginData);

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(content);
                var root = doc.RootElement;

                string nombreRol = root.GetProperty("rol").GetString() ?? "Guardia";
                int userId = root.GetProperty("id").GetInt32();

                await JS.InvokeVoidAsync("localStorage.setItem", "userRole", nombreRol);
                await JS.InvokeVoidAsync("localStorage.setItem", "userId", userId.ToString());

                if (nombreRol == "Administrador") Nav.NavigateTo("/lista-estudiantes", true);
                else Nav.NavigateTo("/gestion-seguridad", true);
            }
            else
            {
                mensajeError = "Credenciales incorrectas.";
            }
        }
        catch (Exception)
        {
            mensajeError = "Error de conexión con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}