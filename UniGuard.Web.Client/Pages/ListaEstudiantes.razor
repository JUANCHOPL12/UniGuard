@page "/lista-estudiantes"
@using UniGuard.Shared
@inject HttpClient Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">🛡️ Gestión de Estudiantes</h3>
            <span class="badge bg-light text-primary">Admin Mode</span>
        </div>
        <div class="card-body">

            <div class="input-group mb-3 shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0"
                       placeholder="Buscar por cédula o nombre..."
                       @bind="filtroBusqueda" @bind:event="oninput" />
            </div>

            @if (estudiantes == null)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">Consultando base de datos...</p>
                </div>
            }
            else if (!EstudiantesFiltrados.Any())
            {
                <div class="alert alert-info text-center">
                    No se encontraron estudiantes con ese criterio.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Documento</th>
                                <th>Nombre Completo</th>
                                <th class="text-center">Equipos</th>
                                <th>Estado</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var est in EstudiantesFiltrados)
                            {
                                @* DOBLE CLIC PARA VER PERFIL *@
                                <tr @ondblclick="() => VerPerfil(est.Id)"
                                    style="cursor: pointer;"
                                    title="Doble clic para ver detalles">
                                    <td class="fw-bold text-primary">@est.Documento</td>
                                    <td>@est.Nombres @est.Apellidos</td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-info text-dark">
                                            @(est.Equipos?.Count ?? 0) Item(s)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(est.EstaActivo ? "bg-success" : "bg-danger")">
                                            @(est.EstaActivo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => VerPerfil(est.Id)">
                                            🔍 Ver Perfil
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <small class="text-muted fst-italic">* Tip: Haz doble clic sobre cualquier fila para ver la foto y equipos del estudiante.</small>
            }
        </div>
    </div>
</div>

@code {
    private List<Estudiante>? estudiantes;
    private string filtroBusqueda = "";

    // Lógica de filtrado en tiempo real
    private IEnumerable<Estudiante> EstudiantesFiltrados =>
        estudiantes?.Where(e => string.IsNullOrWhiteSpace(filtroBusqueda) ||
                                e.Documento.Contains(filtroBusqueda) ||
                                e.Nombres.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                e.Apellidos.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Estudiante>();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            // Cambiamos a Estudiante (modelo completo) para tener la lista de Equipos
            estudiantes = await Http.GetFromJsonAsync<List<Estudiante>>("api/Estudiantes");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            estudiantes = new List<Estudiante>();
        }
    }

    private void VerPerfil(int id)
    {
        Nav.NavigateTo($"/perfil-estudiante/{id}");
    }
}