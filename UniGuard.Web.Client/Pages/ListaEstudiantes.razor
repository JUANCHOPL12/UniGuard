@page "/lista-estudiantes"
@using UniGuard.Shared
@inject HttpClient Http
@inject NavigationManager Nav
@rendermode InteractiveAuto

<div class="container mt-4">
    <div class="card shadow-lg bg-white" style="border: 2px solid #8CC63F; border-radius: 12px; overflow: hidden;">

        <div class="card-header text-white d-flex justify-content-between align-items-center py-3" style="background-color: #8CC63F; border-bottom: none;">
            <h3 class="mb-0 fw-bold"><i class="bi bi-shield-lock"></i> Gestión de Estudiantes</h3>
            <span class="badge bg-white fw-bold shadow-sm" style="color: #8CC63F;">Admin Mode</span>
        </div>

        <div class="card-body p-4 bg-white">
            <div class="input-group mb-4 shadow-sm" style="border-radius: 8px; overflow: hidden;">
                <span class="input-group-text bg-white border-end-0" style="color: #8CC63F;"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0"
                       placeholder="Buscar por cédula o nombre..."
                       style="border-color: #eee;"
                       @bind="filtroBusqueda" @bind:event="oninput" />
            </div>

            @if (estudiantes == null)
            {
                <div class="text-center my-5">
                    <div class="spinner-border" style="color: #8CC63F;" role="status"></div>
                    <p class="mt-2 fw-bold text-muted">Consultando base de datos UniGuard...</p>
                </div>
            }
            else if (!EstudiantesFiltrados.Any())
            {
                <div class="alert text-center border-0 shadow-sm" style="background-color: #f9fff0; color: #8CC63F;">
                    <i class="bi bi-info-circle"></i> No se encontraron estudiantes con ese criterio.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Documento</th>
                                <th>Nombre Completo</th>
                                <th class="text-center">Equipos</th>
                                <th>Estado</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody style="border-top: 0;">
                            @foreach (var est in EstudiantesFiltrados)
                            {
                                <tr @ondblclick="() => VerPerfil(est.Id)"
                                    style="cursor: pointer;"
                                    title="Doble clic para ver detalles">
                                    <td class="fw-bold ps-3" style="color: #8CC63F;">@est.Documento</td>
                                    <td class="text-dark">@est.Nombres @est.Apellidos</td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill fw-bold px-3" style="background-color: #e8f5e9; color: #2e7d32;">
                                            @(est.Equipos?.Count ?? 0) Item(s)
                                        </span>
                                    </td>
                                    <td>
                                        @if (est.EstaActivo)
                                        {
                                            <span class="badge bg-success px-3">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-dark fw-bold shadow-sm"
                                                style="border-radius: 6px; border-color: #8CC63F; color: #333;"
                                                @onclick="() => VerPerfil(est.Id)">
                                            🔍 Ver Perfil
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 p-2 rounded" style="background-color: #f8f9fa;">
                    <small class="text-muted fst-italic">
                        <i class="bi bi-lightbulb" style="color: #8CC63F;"></i>
                        <strong>Tip:</strong> Haz doble clic sobre cualquier fila para ver la foto y equipos del estudiante.
                    </small>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Estudiante>? estudiantes;
    private string filtroBusqueda = "";

    private IEnumerable<Estudiante> EstudiantesFiltrados =>
        estudiantes?.Where(e => string.IsNullOrWhiteSpace(filtroBusqueda) ||
                                e.Documento.Contains(filtroBusqueda) ||
                                e.Nombres.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                e.Apellidos.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Estudiante>();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            estudiantes = await Http.GetFromJsonAsync<List<Estudiante>>("api/Estudiantes");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            estudiantes = new List<Estudiante>();
        }
    }

    private void VerPerfil(int id)
    {
        Nav.NavigateTo($"/perfil-estudiante/{id}");
    }
}