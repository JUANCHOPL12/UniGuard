@page "/registrar-estudiante"
@rendermode InteractiveAuto
@using UniGuard.Shared
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container mt-4">
    <div class="card shadow-lg bg-white" style="border: 2px solid #8CC63F; border-radius: 12px; overflow: hidden;">

        <div class="card-header text-white text-center p-3" style="background-color: #8CC63F; border-bottom: none;">
            <h3 class="fw-bold mb-0"><i class="bi bi-person-plus-fill"></i> Registro de Estudiante Nuevo</h3>
        </div>

        <div class="card-body p-4 bg-white">
            <EditForm Model="@estudiante" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-4 text-center border-end">
                        <label class="fw-bold mb-2" style="color: #8CC63F;">📸 Captura de Foto en Vivo</label>

                        <div class="mb-3 position-relative">
                            <video id="videoEstudiante"
                                   style="width: 100%; max-width: 220px; height: 160px; object-fit: cover; border-radius: 10px; border: 3px solid #8CC63F; background: #000;"
                                   autoplay></video>

                            <div class="mt-2 d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-outline-dark btn-sm fw-bold" @onclick="IniciarCamara">
                                    <i class="bi bi-camera-video"></i> Iniciar
                                </button>
                                <button type="button" class="btn btn-sm text-white fw-bold shadow-sm"
                                        style="background-color: #8CC63F;" @onclick="TomarFoto">
                                    <i class="bi bi-record-circle"></i> Capturar
                                </button>
                            </div>
                        </div>

                        <label class="fw-bold mb-2" style="color: #8CC63F;">🖼️ Resultado de la Foto</label>
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(estudiante.FotoBase64))
                            {
                                <img src="@estudiante.FotoBase64" class="shadow-sm animate__animated animate__fadeIn"
                                     style="width: 180px; height: 180px; object-fit: cover; border-radius: 10px; border: 4px solid #8CC63F;" />
                            }
                            else
                            {
                                <div class="mx-auto d-flex flex-column align-items-center justify-content-center shadow-sm"
                                     style="width: 180px; height: 180px; border-radius: 10px; color: #8CC63F; border: 2px dashed #8CC63F; background-color: #f9fff0;">
                                    <i class="bi bi-person-bounding-box fs-1"></i>
                                    <span class="small fw-bold">Sin Captura</span>
                                </div>
                            }
                        </div>
                        <canvas id="canvasEstudiante" style="display:none;"></canvas>
                    </div>

                    <div class="col-md-8 ps-md-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="fw-bold text-dark small text-uppercase">Número de Cédula</label>
                                <InputText @bind-Value="estudiante.Documento" class="form-control border-2 shadow-sm"
                                           placeholder="Ej: 1109..." />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-dark small text-uppercase">Nombres</label>
                                <InputText @bind-Value="estudiante.Nombres" class="form-control border-2 shadow-sm"
                                           placeholder="Nombres completos" />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-dark small text-uppercase">Apellidos</label>
                                <InputText @bind-Value="estudiante.Apellidos" class="form-control border-2 shadow-sm"
                                           placeholder="Apellidos completos" />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-dark small text-uppercase">Teléfono</label>
                                <InputText @bind-Value="estudiante.Telefono" class="form-control border-2 shadow-sm"
                                           placeholder="Ej: 315..." />
                            </div>
                            <div class="col-md-12">
                                <label class="fw-bold text-dark small text-uppercase">Correo Institucional</label>
                                <InputText @bind-Value="estudiante.CorreoInstitucional" class="form-control border-2 shadow-sm"
                                           placeholder="usuario@cun.edu.co" />
                            </div>
                            <div class="col-md-12">
                                <label class="fw-bold text-dark small text-uppercase">Dirección de Residencia</label>
                                <InputText @bind-Value="estudiante.Direccion" class="form-control border-2 shadow-sm"
                                           placeholder="Calle, Carrera, Barrio..." />
                            </div>

                            <div class="col-md-12 mt-3">
                                <div class="p-2 rounded d-flex align-items-center" style="background-color: #f0f9eb; border: 1px solid #c2e7b0;">
                                    <i class="bi bi-shield-check-fill text-success fs-5 me-2"></i>
                                    <span class="text-success fw-bold small">EL ESTUDIANTE SE REGISTRARÁ COMO ACTIVO</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit"
                                    class="btn btn-lg mt-4 fw-bold shadow text-white"
                                    style="background-color: #8CC63F; height: 55px; font-size: 1.2rem;"
                                    disabled="@CamposIncompletos">
                                <i class="bi bi-person-check"></i> GUARDAR REGISTRO EN UNIGUARD
                            </button>
                        </div>

                        @if (CamposIncompletos)
                        {
                            <div class="alert mt-3 py-2 text-center border-0 shadow-sm"
                                 style="background-color: #fff3cd; color: #856404; border-left: 5px solid #ffc107 !important;">
                                <small><i class="bi bi-info-circle"></i> Complete todos los campos y tome la foto para habilitar el guardado.</small>
                            </div>
                        }
                    </div>
                </div>
            </EditForm>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert mt-4 text-center shadow-sm fw-bold animate__animated animate__pulse"
                     style="background-color: #fff; border: 1px solid #8CC63F; border-left: 8px solid #8CC63F; color: #333;">
                    @mensaje
                </div>
            }
        </div>
    </div>
</div>

@code {
    Estudiante estudiante = new Estudiante { EstaActivo = true };
    string mensaje = "";

    // Validación: El botón no se activa hasta que todo esté lleno, incluyendo foto
    private bool CamposIncompletos =>
        string.IsNullOrWhiteSpace(estudiante.Documento) ||
        string.IsNullOrWhiteSpace(estudiante.Nombres) ||
        string.IsNullOrWhiteSpace(estudiante.Apellidos) ||
        string.IsNullOrWhiteSpace(estudiante.Telefono) ||
        string.IsNullOrWhiteSpace(estudiante.CorreoInstitucional) ||
        string.IsNullOrWhiteSpace(estudiante.Direccion) ||
        string.IsNullOrEmpty(estudiante.FotoBase64);

    async Task IniciarCamara()
    {
        mensaje = "⏳ Encendiendo cámara...";
        var exito = await JS.InvokeAsync<bool>("iniciarCamara", "videoEstudiante");
        mensaje = exito ? "✅ Cámara lista." : "❌ No se pudo acceder a la cámara.";
    }

    async Task TomarFoto()
    {
        try
        {
            var data = await JS.InvokeAsync<string>("capturarFoto", "videoEstudiante", "canvasEstudiante");
            if (!string.IsNullOrEmpty(data))
            {
                estudiante.FotoBase64 = data;
                mensaje = "✅ Foto capturada correctamente.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            mensaje = "❌ Error al capturar la imagen.";
            Console.WriteLine(ex.Message);
        }
    }

    async Task Guardar()
    {
        mensaje = "⏳ Procesando registro...";
        // Forzamos que siempre sea activo al guardar
        estudiante.EstaActivo = true;

        try
        {
            var res = await Http.PostAsJsonAsync("api/Estudiantes", estudiante);
            if (res.IsSuccessStatusCode)
            {
                mensaje = "✅ ¡Estudiante registrado y activo en el sistema!";
                // Reiniciar formulario manteniendo el estado activo para el siguiente
                estudiante = new Estudiante { EstaActivo = true };
                StateHasChanged();
            }
            else
            {
                mensaje = "❌ Error: Verifique si la cédula ya existe o revise la conexión.";
            }
        }
        catch (Exception)
        {
            mensaje = "❌ Error crítico de comunicación con el servidor.";
        }
    }
}