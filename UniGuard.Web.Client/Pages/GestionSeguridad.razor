@page "/gestion-seguridad"
@rendermode InteractiveAuto
@using UniGuard.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container mt-4">
    <div class="card shadow-lg bg-white" style="border: 2px solid #8CC63F;">

        <div class="card-header text-white text-center" style="background-color: #8CC63F; border-bottom: none;">
            <h3 class="fw-bold mb-0"> ACCESO DE ESTUDIANTES </h3>
        </div>

        <div class="card-body bg-white">
            <div class="row mb-4">
                <div class="col-md-8">
                    <input type="text" @bind="cedulaBusqueda" class="form-control form-control-lg bg-white"
                           placeholder="Digite Cédula del Estudiante..."
                           style="border: 2px solid #8CC63F;"
                           @onkeyup="@(async (e) => { if (e.Key == "Enter") await Buscar(); })" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button class="btn btn-lg flex-grow-1 text-white fw-bold shadow-sm"
                                style="background-color: #8CC63F; border: none;"
                                @onclick="Buscar">
                            BUSCAR
                        </button>

                        @if (userRole == "Administrador" && estudiante == null && !string.IsNullOrEmpty(cedulaBusqueda))
                        {
                            <button class="btn btn-success btn-lg shadow-sm fw-bold" @onclick="IrARegistrar">
                                <i class="bi bi-person-plus-fill"></i> REGISTRAR
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (estudiante != null)
            {
                <div class="row border p-3 bg-white rounded shadow-sm animate__animated animate__fadeIn" style="border-color: #eee !important;">
                    <div class="col-md-4 text-center border-end">
                        @if (!string.IsNullOrEmpty(estudiante.FotoBase64))
                        {
                            <img src="@estudiante.FotoBase64" class="rounded shadow mb-3"
                                 style="width: 100%; max-width: 250px; border: 5px solid #8CC63F; height: 250px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded d-flex align-items-center justify-content-center mx-auto mb-3 bg-white shadow-sm"
                                 style="width: 250px; height: 250px; border: 3px dashed #8CC63F;">
                                <i class="bi bi-person text-muted" style="font-size: 5rem;"></i>
                            </div>
                        }
                        <h4 class="text-uppercase fw-bold" style="color: #8CC63F;">@estudiante.Nombres @estudiante.Apellidos</h4>
                        <p class="badge fs-6 rounded-pill px-3" style="background-color: #8CC63F;">Documento: @estudiante.Documento</p>
                    </div>

                    <div class="col-md-8 bg-white">
                        <h5 class="fw-bold" style="color: #8CC63F;"><i class="bi bi-plus-circle"></i> Nuevo Registro de Equipo</h5>
                        <div class="p-3 bg-white rounded border mb-4 shadow-sm" style="border-top: 5px solid #8CC63F !important;">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label class="form-label small fw-bold">Número de Serial</label>
                                    <input type="text" @bind="nuevoSerial" class="form-control form-control-sm border-1 shadow-sm" placeholder="Ej: SN-98765" />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label small fw-bold">Marca</label>
                                    <select class="form-select form-select-sm border-1 shadow-sm" @bind="nuevaMarcaId">
                                        <option value="0">-- Seleccione Marca --</option>
                                        <option value="1">HP</option>
                                        <option value="2">Lenovo</option>
                                        <option value="3">Dell</option>
                                        <option value="4">Apple</option>
                                        <option value="5">Asus</option>
                                        <option value="6">Acer</option>
                                    </select>
                                </div>
                            </div>
                            <button class="btn btn-sm w-100 mt-1 fw-bold text-white shadow-sm"
                                    style="background-color: #8CC63F;"
                                    @onclick="VincularEquipo"
                                    disabled="@(string.IsNullOrWhiteSpace(nuevoSerial) || nuevaMarcaId == 0 || mensaje.Contains("⏳"))">
                                💾 GUARDAR EQUIPO
                            </button>
                        </div>

                        <h5 class="fw-bold text-dark"><i class="bi bi-laptop"></i> Equipos Vinculados:</h5>
                        <div class="list-group shadow-sm">
                            @if (estudiante.Equipos != null && estudiante.Equipos.Any())
                            {
                                @foreach (var eq in estudiante.Equipos)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center mb-2 bg-white border shadow-sm"
                                         style="border-left: 6px solid #8CC63F !important;">
                                        <div>
                                            <span class="fw-bold text-dark">@eq.Serial</span>
                                            <span class="badge bg-light text-dark border ms-2">@(eq.Marca?.Nombre ?? "Marca")</span>
                                            <br />
                                            <small class="badge @(eq.EstadoActualId == 1 ? "bg-success" : "bg-warning text-dark")">
                                                @(eq.EstadoActualId == 1 ? "DENTRO" : "FUERA")
                                            </small>
                                        </div>
                                        <div>
                                            @if (eq.EstadoActualId == 2)
                                            {
                                                <button class="btn btn-success fw-bold px-4 shadow-sm" @onclick="() => ProcesarMovimiento(eq, 1)">📥 ENTRADA</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-warning fw-bold px-4 shadow-sm" @onclick="() => ProcesarMovimiento(eq, 2)">📤 SALIDA</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-light text-center border bg-white shadow-sm">Este estudiante no tiene equipos registrados.</div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert mt-3 text-center fw-bold shadow-sm bg-white"
                     style="border: 1px solid #8CC63F; border-left: 8px solid #8CC63F; color: #333;">
                    @mensaje
                </div>
            }
        </div>
    </div>
</div>

@code {
    // SE MANTIENE TODA TU LÓGICA ORIGINAL PARA EVITAR ERRORES
    private string cedulaBusqueda = "";
    private string nuevoSerial = "";
    private int nuevaMarcaId = 0;
    private string mensaje = "";
    private Estudiante? estudiante;
    private string? userRole;

    private async Task ConfigurarSeguridad()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task<int> ObtenerUsuarioId()
    {
        var idStr = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
        return int.TryParse(idStr, out var id) ? id : 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
            if (string.IsNullOrEmpty(userRole)) Nav.NavigateTo("/", true);
            StateHasChanged();
        }
    }

    private void IrARegistrar() => Nav.NavigateTo($"/registrar-estudiante?cedula={cedulaBusqueda}");

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(cedulaBusqueda)) return;

        mensaje = "🔍 Buscando...";
        try
        {
            await ConfigurarSeguridad();
            var result = await Http.GetAsync($"api/Estudiantes/buscar-por-documento/{cedulaBusqueda}");

            if (result.IsSuccessStatusCode)
            {
                estudiante = await result.Content.ReadFromJsonAsync<Estudiante>();
                mensaje = "";
            }
            else
            {
                estudiante = null;
                mensaje = "❌ Estudiante no encontrado.";
            }
        }
        catch (Exception) { mensaje = "❌ Error de conexión."; }
    }

    private async Task ProcesarMovimiento(Equipo equipo, int nuevoEstado)
    {
        try
        {
            mensaje = "⏳ Registrando...";
            await ConfigurarSeguridad();
            int idGuardia = await ObtenerUsuarioId();

            var movimiento = new Movimiento
            {
                EquipoId = equipo.Id,
                TipoMovimiento = (nuevoEstado == 1) ? "Entrada" : "Salida",
                FechaHora = DateTime.Now,
                Observaciones = "Registro rápido en portería",
                UsuarioSistemaId = idGuardia
            };

            var resp = await Http.PostAsJsonAsync("api/Movimientos", movimiento);
            if (resp.IsSuccessStatusCode)
            {
                mensaje = (nuevoEstado == 1) ? "✅ ENTRADA registrada" : "✅ SALIDA registrada";
                await Buscar();
            }
            else { mensaje = "❌ Error al procesar movimiento."; }
        }
        catch (Exception ex) { mensaje = "❌ Error: " + ex.Message; }
    }
    private async Task VincularEquipo()
    {
        if (estudiante == null || string.IsNullOrWhiteSpace(nuevoSerial) || nuevaMarcaId == 0) return;

        try
        {
            mensaje = "⏳ Vinculando equipo...";
            await ConfigurarSeguridad();

            // Creamos el objeto del equipo
            // IMPORTANTE: Ponemos EstadoActualId = 2 (FUERA) para que no entre de una vez
            var equipo = new Equipo
            {
                Serial = nuevoSerial.Trim().ToUpper(),
                MarcaId = nuevaMarcaId,
                EstudianteId = estudiante.Id,
                EstadoActualId = 2,
                FechaRegistro = DateTime.Now
            };

            // ENVIAMOS SOLO EL EQUIPO (Eliminé la parte que creaba el Movimiento automáticamente)
            var respEq = await Http.PostAsJsonAsync("api/Equipos", equipo);

            if (respEq.IsSuccessStatusCode)
            {
                nuevoSerial = "";
                nuevaMarcaId = 0;
                mensaje = "✅ Equipo registrado. Ahora puede marcar la ENTRADA abajo.";

                // Refrescamos la interfaz para que el equipo aparezca en la lista de abajo
                await Buscar();
            }
            else
            {
                var errorServidor = await respEq.Content.ReadAsStringAsync();
                mensaje = string.IsNullOrEmpty(errorServidor) ? "❌ Error al vincular equipo." : errorServidor;
            }
        }
        catch (Exception ex) { mensaje = "❌ Error técnico: " + ex.Message; }
    }
}